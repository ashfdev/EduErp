DATABASE_URL="postgresql://user:password@localhost:5432/education_erp"
REDIS_URL="redis://localhost:6379"

NOTIFICATION_SERVICE_PORT=4600

# Must be the SAME value as server/api's ENCRYPTION_KEY -- this service
# decrypts SMS gateway credentials that server/api's Settings routes
# encrypt (Settings -> SMS Gateway), so both processes need the identical
# key to agree on ciphertext.
ENCRYPTION_KEY="a-long-random-string-used-to-derive-the-encryption-key"

# SMS (SSL Wireless BD) -- used only as a fallback when no gateway is
# active in Settings -> SMS Gateway; once an admin activates one there
# (SSL Wireless, BulkSMSBD, or a custom provider), these env vars are no
# longer read.
SMS_API_URL="https://sms.sslwireless.com/pushapi/dynamic/server.php"
SMS_API_TOKEN=""
SMS_SID=""

# Email
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@institution.edu.bd"

# Web Push — generate your own VAPID keypair via:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@institution.edu.bd"
