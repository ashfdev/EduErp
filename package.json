{
  "name": "education-erp",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "ulimit -n 4096 2>/dev/null || true && turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter=@education-erp/db exec prisma generate",
    "db:migrate": "pnpm --filter=@education-erp/db exec prisma migrate dev",
    "db:seed": "pnpm --filter=@education-erp/db exec prisma db seed",
    "db:studio": "pnpm --filter=@education-erp/db exec prisma studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.21",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
