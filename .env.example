# ═══════════════════════════════════════════════════════════════
# Education ERP — Environment Variables Reference
# ═══════════════════════════════════════════════════════════════
# Each service loads its OWN .env from its own directory (not this file
# directly) — see packages/db/.env, server/api/.env, services/device/.env,
# services/notification/.env, and apps/{admin,portal,website}/.env.local.
# This root file documents every variable used anywhere in the monorepo so
# a new environment can be provisioned from a single reference.

# ─── Database (packages/db/.env, server/api/.env, services/device/.env,
#     services/notification/.env) ───
DATABASE_URL="postgresql://user:password@localhost:5432/education_erp"
REDIS_URL="redis://localhost:6379"

# ─── Auth (server/api/.env) ───
JWT_ACCESS_SECRET="your-access-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ─── Server (server/api/.env) ───
PORT=4000
NODE_ENV="development"

# ─── Azure Blob Storage (server/api/.env) — omit both to fall back to local
#     disk storage under server/api/local-uploads/ for development ───
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_BLOB_CONTAINER_NAME="education-erp"

# ─── Payment Gateways (server/api/.env) — each adapter reports itself as
#     "not configured" and fails closed until its credentials are set ───
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_SANDBOX=true

NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""
NAGAD_SANDBOX=true

SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_SANDBOX=true

# ─── App URLs (server/api/.env — also used for CORS allowlist; REQUIRED in
#     production, see app.ts's boot-time check) ───
ADMIN_URL="http://localhost:3000"
PORTAL_URL="http://localhost:3001"
WEBSITE_URL="http://localhost:3002"
API_URL="http://localhost:4000"
WEBSITE_REVALIDATE_SECRET="your-revalidate-secret"

# ─── Puppeteer (server/api/.env) — required in Docker/Linux, usually unset
#     locally on Windows/Mac where Puppeteer bundles its own Chromium ───
PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium-browser"

# ─── Device Service (services/device/.env) — ADMS biometric bridge ───
DEVICE_SERVICE_PORT=4500
DEVICE_SERVICE_SECRET="shared-secret-with-server-api"

# ─── Notification Service (services/notification/.env) — SMS/Email/Push
#     workers. Left empty on purpose in dev: each provider falls back to a
#     mock/logging implementation when its credentials are unset ───
NOTIFICATION_SERVICE_PORT=4600

# SMS — SSL Wireless BD (primary gateway)
SMS_API_URL="https://sms.sslwireless.com/pushapi/dynamic/server.php"
SMS_API_TOKEN=""
SMS_SID=""

# Email — SMTP
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@institution.edu.bd"

# Web Push — VAPID keypair. Generate your own per environment via:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@institution.edu.bd"
